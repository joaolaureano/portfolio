---
import { site } from '../data/site';

const isHome = Astro.url.pathname === '/';
const base = isHome ? '' : '/';
const nav = [
  { href: `${base}#work`, label: 'Work' },
  { href: `${base}#experience`, label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Home">
      <span class="mono">jpl</span><span class="dot">.</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li>
          <a href={site.links.github} rel="me noopener" target="_blank" aria-label="GitHub">
            <svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
          </a>
        </li>
        <li>
          <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
            <svg class="sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"
              ><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"
              ></circle><path
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              ></path></svg
            >
            <svg class="moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"
              ><path
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
                d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg
            >
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const dark = () => root.dataset.theme !== 'light';
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = dark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.75rem;
  }
  .brand {
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .dot {
    color: var(--accent);
  }
  ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.55rem;
    border-radius: 6px;
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover,
  .theme-toggle:hover {
    color: var(--text);
    background: var(--tag-bg);
  }
  .theme-toggle {
    border: 0;
    background: none;
    cursor: pointer;
  }
  .sun {
    display: none;
  }
  :global(:root[data-theme='light']) .sun {
    display: block;
  }
  :global(:root[data-theme='light']) .moon {
    display: none;
  }
  @media (max-width: 420px) {
    nav li:nth-child(2) {
      display: none;
    }
  }
</style>
